{
  "$comment": "CVFetch：论文元数据与作者动态分别展示；缺少采集凭据的作者源默认暂停。",
  "sources": [
    {
      "id": "arxiv-cv",
      "name": "arXiv · Computer Vision",
      "kind": "rss",
      "config": {
        "feedUrl": "https://export.arxiv.org/api/query?search_query=cat%3Acs.CV&start=0&max_results=50&sortBy=submittedDate&sortOrder=descending",
        "summaryIsBody": true,
        "_aihot": {
          "initialBackfillLimit": 10
        },
        "contentType": "paper",
        "platform": "arXiv",
        "profileUrl": "https://arxiv.org/list/cs.CV/recent"
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": [
        "论文/研究"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "semantic-scholar-cv",
      "name": "Semantic Scholar · CV",
      "kind": "json_list",
      "config": {
        "adapter": "semantic_scholar",
        "query": "\"computer vision\" | \"image segmentation\" | \"object detection\" | \"video generation\" | \"3D reconstruction\" | \"vision language\"",
        "lookbackDays": 90,
        "contentType": "paper",
        "platform": "Semantic Scholar",
        "profileUrl": "https://www.semanticscholar.org/",
        "_aihot": {
          "initialBackfillLimit": 5
        }
      },
      "tier": "T1",
      "first_party": false,
      "owner_entity_id": null,
      "participation_mode": "editorial",
